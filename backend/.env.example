# Copy to .env for local development. Never commit the real .env file.

APP_NAME=nubara-backend
ENVIRONMENT=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Passenger query intake (design D12) and the conversational agent
# (change build-disruption-agent, design D7). INTENT_CLASSIFIER=keyword and
# no key run the whole service, including /api/v1/conversations, in
# degraded mode: a deterministic pipeline and template replies, no model call.
INTENT_CLASSIFIER=keyword
# A free-tier Gemini model, confirmed in Google AI Studio (not Vertex AI).
INTENT_MODEL=gemini-3.8-flash
# Get a key at https://aistudio.google.com/apikey. INTENT_MODEL_API_KEY is
# read by this app's Settings; the value is also exported as GOOGLE_API_KEY
# at call time, which is what the google-genai client itself looks for.
# Never commit a real key.
INTENT_MODEL_API_KEY=
GOOGLE_API_KEY=
