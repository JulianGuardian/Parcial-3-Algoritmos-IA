# Copy to .env for local development. Never commit the real .env file.

APP_NAME=nubara-backend
ENVIRONMENT=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Passenger query intake (design D12).
# INTENT_CLASSIFIER=keyword runs the service with no model dependency.
INTENT_CLASSIFIER=keyword
INTENT_MODEL=gemini-2.0-flash
INTENT_MODEL_API_KEY=
